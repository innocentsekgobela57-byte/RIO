<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R I O - V3"
        android:textColor="#FF6A00"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView android:id="@+id/outputText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Yo moss! V3 installed with bubble!"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="#1E1E1E"
        android:padding="15dp"/>

    <EditText android:id="@+id/inputText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Type: open WhatsApp"
        android:textColor="#FFFFFF"
        android:textColorHint="#808080"
        android:background="#2A2A2A"
        android:layout_marginTop="10dp"
        android:padding="12dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/sendButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="SEND"/>
        <Button android:id="@+id/micButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="MIC" android:layout_marginStart="5dp"/>
        <Button android:id="@+id/bubbleButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="BUBBLE" android:layout_marginStart="5dp"/>
    </LinearLayout>
</LinearLayout>
